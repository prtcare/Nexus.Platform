<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nexus.Platform.Architecture.Tests</RootNamespace>
    <AssemblyName>Nexus.Platform.Architecture.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexus.Platform.Core\Nexus.Platform.Core.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Platform.Contracts\Nexus.Platform.Contracts.csproj" />
    <!-- W5G / F-01: the Nexus.Platform.Providers.OpenAI ProjectReference was removed here.
         The provider moved to the AI Head, so this Platform test project can no longer
         see it; the provider-coupled assertions that used to live in
         PlatformBoundaryTests.cs and SecretBoundaryTests.cs moved with it to
         Nexus.Intelligence.Architecture.Tests in the same change. Leaving the reference
         would have failed the build outright; leaving the assertions without moving them
         would have silently deleted a live security control. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

</Project>

