         Platform.Core dependency was the model domain, which F-01 also moves. -->
    <Project Path="src\Nexus.Platform.Tools\Nexus.Platform.Tools.csproj" />
    <Project Path="src\Nexus.Platform.Identity\Nexus.Platform.Identity.csproj" />
    <Project Path="src\Nexus.Platform.Persistence\Nexus.Platform.Persistence.csproj" />
