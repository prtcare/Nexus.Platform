  <Folder Name="/tests/">
    <!-- W5G / F-01: Nexus.Platform.Tests was REMOVED from this solution. Its only
         source file was ModelCatalogTests.cs (9 tests over AggregatingModelCatalog /
         IModelCatalogSource / IModelCatalog), which moved to the AI Head with the types
         it covers. That left the project with ZERO test files while still building a
         DLL and still being listed here - and `dotnet test` on this solution then exits
         0 while reporting only "No test is available in ...Nexus.Platform.Tests.dll"
         (measured, not inferred). A test project that cannot fail is the exact
         named-safety-check-that-cannot-fail defect this audit keeps finding, so it is
         not left in place. The project directory is retained on disk so its history is
         untouched and it can be re-added the moment it has tests again; the coverage
         gap this exposed is recorded as W5G finding D-13. -->
    <Project Path="tests\Nexus.Platform.Architecture.Tests\Nexus.Platform.Architecture.Tests.csproj" />
    <Project Path="tests\Nexus.ProductCore.Scope.Tests\Nexus.ProductCore.Scope.Tests.csproj" />
    <Project Path="tests\Nexus.Governance.Tests\Nexus.Governance.Tests.csproj" />
    <Project Path="tests\Nexus.Delivery.Tests\Nexus.Delivery.Tests.csproj" />
  </Folder>
  <Folder Name="/tools/">
    <!-- W9.2: the build-and-certify driver. In the solution deliberately: a driver kept outside it is a
         driver nothing builds, and this estate has already recorded the cost of that pattern twice (a
         sample host that stopped compiling, and a test project that vanished from the solution and could
         no longer fail). Being in the solution makes it subject to Platform's boundary suites, which is
         correct — it reads source trees, so it is among the last components that should be trusted on its
         own word to stay provider-neutral. -->
    <Project Path="tools\Nexus.Delivery.Build\Nexus.Delivery.Build.csproj" />
  </Folder>
